PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kitools

MAIN_DB_HOST=localhost
MAIN_DB_PORT=5432
MAIN_DB_USER=postgres
MAIN_DB_PASSWORD=postgres
MAIN_DB_NAME=kitools
MAIN_DB_MIGRATIONS_RUN=false

TOOL_DB_HOST=localhost
TOOL_DB_PORT=5432
TOOL_DB_USER=postgres
TOOL_DB_PASSWORD=postgres
TOOL_DB_NAME=kitools
TOOL_DB_MIGRATIONS_RUN=false

AUDIT_DB_HOST=localhost
AUDIT_DB_PORT=5433
AUDIT_DB_USER=postgres
AUDIT_DB_PASSWORD=postgres
AUDIT_DB_NAME=kitools_audit
AUDIT_DB_MIGRATIONS_RUN=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120
# Chặn gửi trùng (cùng hash body+path+method+ip) trong cửa sổ này (giây). Upload multipart không áp dụng (body chưa parse ở interceptor).
ANTI_SPAM_TTL_SECONDS=6

UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=500000000

# Chunk upload cho video lớn (5GB+). Chunks lưu tạm tại UPLOAD_DIR/_chunks/<uploadId>/
# CHUNK_UPLOAD_DIR= (mặc định dùng UPLOAD_DIR)
CHUNK_UPLOAD_MAX_FILE_BYTES=10737418240

# (Tùy chọn) Thư mục tuyệt đối có quyền ghi cho output TTS / clone / preview audio (con: audio-tts, audio-clone, audio-previews).
# Dùng khi process không mkdir được trong repo (EACCES). Ví dụ: AUDIO_DATA_ROOT=/var/tmp/kitools-audio
# AUDIO_DATA_ROOT=

# OmniVoice TTS — khớp demo OmniVoice 0.2.x
# Inference steps=32, CFG=2, denoise/preprocess/postprocess = on
OMNIVOICE_SEED=42
OMNIVOICE_NUM_STEP=32
OMNIVOICE_GUIDANCE_SCALE=2
OMNIVOICE_DENOISE=true
OMNIVOICE_PREPROCESS_PROMPT=true
OMNIVOICE_POSTPROCESS_OUTPUT=true

# VoxCPM2 TTS — seed cố định (voice consistency). none = random.
VOXCPM2_SEED=42

TRANSLATE_PYTHON_BIN=python
TRANSLATE_PYTHON_SCRIPT=tools/video-pipeline/auto_vietsub_pro.py
TRANSLATE_CMD_TIMEOUT_MS=1200000
# Kết quả cuối (mp4/srt) — logic cũ, vd. ổ Windows qua WSL
TRANSLATE_WORK_ROOT=/mnt/c/Users/haikh/Videos/VideoVietsub/videos

# Movie Recap (narrated review)
RECAP_PYTHON_BIN=tools/video-pipeline/.venv/bin/python
RECAP_PYTHON_SCRIPT=tools/video-pipeline/recap/run_recap.py
RECAP_CMD_TIMEOUT_MS=3600000
RECAP_WORK_ROOT=uploads/recap
RECAP_WHISPER_MODEL=base
RECAP_WHISPER_DEVICE=cpu
RECAP_GEMINI_MODEL=gemini-2.5-flash
RECAP_GEMINI_KEY_TIER=vip
RECAP_GEMINI_RETRY_MAX=1
RECAP_GEMINI_RETRY_DEBOUNCE_SEC=3
RECAP_TRANSCRIPT_MAX_CHARS=120000

# ShortVideo (9:16 render engine)
SHORTVIDEO_PYTHON_BIN=tools/video-pipeline/.venv/bin/python
SHORTVIDEO_PYTHON_SCRIPT=tools/video-pipeline/shortvideo/render.py
SHORTVIDEO_CMD_TIMEOUT_MS=1800000
SHORTVIDEO_WORK_ROOT=uploads/shortvideo
# FFMPEG_BIN is read by the python renderer (defaults to "ffmpeg")

SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Gemini — Videos AI Task (Key Normal) + Translate Step2 standard pool.
# Một key: AIzaSy...
# Nhiều key (round-robin): key1,key2  |  key1;key2  |  key1|key2  |  ["key1","key2"]
GEMINI_API_KEY=

# Key VIP — Videos AI Task (Key VIP), Translate --gemini-key-tier vip, YouTube AI.
# Cùng format nhiều key như GEMINI_API_KEY.
# Ví dụ: GEMINI_API_KEY_VIP=key1,key2,key3
GEMINI_API_KEY_VIP=

# Gemini Veo 3.1 — video generation (uses GEMINI_API_KEY / GEMINI_API_KEY_VIP pools above)
VEO_DEFAULT_MODEL=veo-3.1-generate-preview
VEO_STATUS_TIMEOUT_MS=30000
VEO_DOWNLOAD_TIMEOUT_MS=300000
VEO_BACKGROUND_POLL_INTERVAL_MS=10000
VEO_BACKGROUND_TIMEOUT_MS=900000

# Gemini Nano Banana — Text-to-Image (uses Gemini key pools above)
GEMINI_IMAGE_DEFAULT_MODEL=gemini-3.1-flash-image

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/api/youtube/auth/google/callback
FRONTEND_URL=http://localhost:3001
YOUTUBE_AI_MODEL=gemini-2.5-pro
YOUTUBE_AI_TEMPERATURE=0.2
TRENDS_PYTHON_BIN=python
TRENDS_PYTHON_SCRIPT=tools/trends/fetch_trends.py

# ─── Image Generation — ComfyUI API ───
# ComfyUI server URL (localhost Docker, mặc định http://127.0.0.1:8188)
COMFYUI_URL=http://127.0.0.1:8188
# Timeout WS chờ ComfyUI xong (ms). Mặc định 5 phút.
COMFYUI_TIMEOUT_MS=300000
# Model mặc định
IMAGE_DEFAULT_MODEL=z-image-turbo
# Workflow path (map trong workflow-image.constants.ts)
COMFYUI_WORKFLOW_PATH=tools/comfyui/workflow_api.json

# yt-dlp microservice
YTDLP_SERVICE_URL=http://localhost:8100

# Playwright microservice
DOUYIN_PLAYWRIGHT_SERVICE_URL=http://localhost:8101

# Douyin cookies (server-side only, do not commit)
# DOUYIN_COOKIE_FILE=secrets/douyin-cookies.txt
# Or inline Netscape cookie content:
# DOUYIN_COOKIE_CONTENT=

# Douyin extract provider: playwright | ytdlp
# DOUYIN_EXTRACT_PROVIDER=playwright
# Override per use-case (optional):
# DOUYIN_VIDEO_EXTRACT_PROVIDER=playwright
# DOUYIN_PROFILE_EXTRACT_PROVIDER=playwright

# ─── Whiteboard Reveal Engine ────────────────────────────────────────────────
# Gemini model for vision analysis (default: gemini-2.5-flash)
# WHITEBOARD_GEMINI_MODEL=gemini-2.5-flash
# Working directory for uploaded images and render outputs
# WHITEBOARD_WORK_ROOT=uploads/whiteboard
# Max upload size in bytes (default: 30 MB)
# WHITEBOARD_UPLOAD_MAX_BYTES=30000000
# BullMQ job timeout in ms (default: 1800000 = 30 min)
# WHITEBOARD_CMD_TIMEOUT_MS=1800000
# BullMQ lock duration override (default: WHITEBOARD_CMD_TIMEOUT_MS + 120s)
# WHITEBOARD_QUEUE_LOCK_MS=
# Path to the Remotion composition entry point
# WHITEBOARD_REMOTION_ENTRY=tools/whiteboard-remotion/src/index.tsx
# Path to the Remotion public dir (hand asset etc.)
# WHITEBOARD_REMOTION_PUBLIC=tools/whiteboard-remotion/public
# Chrome/Chromium dùng để render. Bỏ trống = Remotion tự tải vào node_modules/.remotion
# (chỉ hoạt động khi user chạy service ghi được vào node_modules).
# WHITEBOARD_BROWSER_EXECUTABLE=/usr/bin/chromium

# Hugging Face Read token — OmniVoice gated model
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HF / torch cache CHUNG (Whisper, OmniVoice…) — mặc định:
#   tools/video-pipeline/cache/huggingface/hub
# KITLABS_PYTHON_CACHE_DIR=/var/cache/kitools-python
# VIDEO_IMAGES_DATA_ROOT=/var/tmp/kitools-video-images