{
  "name": "kitools-be",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migration:run:main": "typeorm-ts-node-commonjs -d src/database/data-source.main.ts migration:run",
    "migration:revert:main": "typeorm-ts-node-commonjs -d src/database/data-source.main.ts migration:revert",
    "migration:generate:main": "typeorm-ts-node-commonjs -d src/database/data-source.main.ts migration:generate src/database/migrations/main/InitSchema",
    "migration:run:tool": "typeorm-ts-node-commonjs -d src/database/data-source.tool.ts migration:run",
    "migration:revert:tool": "typeorm-ts-node-commonjs -d src/database/data-source.tool.ts migration:revert",
    "migration:generate:tool": "typeorm-ts-node-commonjs -d src/database/data-source.tool.ts migration:generate src/database/migrations/main/InitSchema",
    "migration:run:audit": "typeorm-ts-node-commonjs -d src/database/data-source.audit.ts migration:run",
    "migration:revert:audit": "typeorm-ts-node-commonjs -d src/database/data-source.audit.ts migration:revert",
    "migration:generate:audit": "typeorm-ts-node-commonjs -d src/database/data-source.audit.ts migration:generate src/database/migrations/audit/InitAuditSchema",
    "migration:squash": "ts-node --transpile-only scripts/squash-migrations.ts",
    "migration:run:desktop": "node dist/database/run-desktop-migrations.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "desktop:prepare": "npm install && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/hub": "^2.16.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/platform-socket.io": "^11.1.16",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.16",
    "@remotion/bundler": "^4.0.501",
    "@remotion/renderer": "^4.0.501",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.71.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "google-auth-library": "^10.9.0",
    "googleapis": "^173.0.0",
    "ioredis": "^5.10.0",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^5.11.0",
    "reflect-metadata": "^0.2.2",
    "remotion": "^4.0.501",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.501",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.0.3",
    "jest": "^30.4.2",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
